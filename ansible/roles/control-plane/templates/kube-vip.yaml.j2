apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  hostNetwork: true
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
      imagePullPolicy: IfNotPresent
      args: ["manager"]
      env:
        - name: address
          value: "{{ kube_vip_address }}"
        - name: port
          value: "6443"
        - name: vip_arp
          value: "true"
        - name: vip_interface
          value: "{{ kube_vip_interface | default(ansible_default_ipv4.interface) }}"
        - name: vip_cidr
          value: "32"
        - name: cp_enable
          value: "true"
        - name: cp_namespace
          value: kube-system
        - name: vip_leaderelection
          value: "true"
        - name: vip_leasename
          value: plndr-cp-lock
        - name: vip_leaseduration
          value: "5"
        - name: vip_renewdeadline
          value: "3"
        - name: vip_retryperiod
          value: "1"
      securityContext:
        capabilities:
          add: ["NET_ADMIN", "NET_RAW"]
      volumeMounts:
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
  hostAliases:
    - hostnames:
        - kubernetes
      ip: 127.0.0.1
  volumes:
    - name: kubeconfig
      hostPath:
        # container always reads admin.conf; the host side varies during
        # first-node bootstrap (super-admin.conf) vs steady state
        path: {{ kube_vip_kubeconfig }}
