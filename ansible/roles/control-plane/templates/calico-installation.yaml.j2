apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    bgp: Enabled
    # Node addresses (BGP peering + route next-hops) come from the
    # Thunderbolt NIC, not the default-route Wi-Fi NIC: macOS MAC-NATs
    # bridged VM traffic on Wi-Fi and drops routed pod packets
    # (see docs/network.md).
    nodeAddressAutodetectionV4:
      interface: {{ tb_interface }}
    ipPools:
      - name: default-ipv4-ippool
        blockSize: 26
        cidr: {{ pod_network_cidr }}
        # All five nodes share one flat L2 subnet: pure iBGP-distributed
        # routes, no encapsulation — tcpdump shows real pod IPs on the wire.
        encapsulation: None
        natOutgoing: Enabled
        nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
